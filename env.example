# Servidor
PORT=5000
NODE_ENV=production
SITE_URL=https://example.com

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@example.com
EMAIL_PASS=senha-de-app
EMAIL_RECIPIENT=contato@example.com

# Segurança
# Use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
ADMIN_USER=replace-with-admin-username
# ADMIN_PASSWORD deve ser um hash bcrypt, nunca a senha em texto puro.
# Exemplo para gerar localmente:
# node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "sua-senha-forte"
ADMIN_PASSWORD=replace-with-bcrypt-hash

# Uma ou mais origens, separadas por vírgula.
CORS_ORIGIN=https://example.com

# Email/infra legados opcionais
HELMET_ENABLED=true
LOG_LEVEL=error
DEBUG_MODE=false
STATS_CACHE_DURATION=300000
MAX_FILE_SIZE=10485760
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000

# Banco de dados (opcional / futuro)
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=replace-me
# DB_NAME=dashboat_tour

# WhatsApp Business API (opcional / futuro)
# WHATSAPP_TOKEN=replace-me
# WHATSAPP_PHONE_ID=replace-me
